{
  "name": "ai-shop-workbench",
  "productName": "EC AI",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "db:init": "tsx scripts/init-db.ts",
    "db:acceptance": "tsx scripts/db-acceptance.ts",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "pdf-parse": "^1.1.1",
    "pinia": "^4.0.3",
    "systeminformation": "^5.33.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.ecai.workbench",
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "resources",
        "to": "resources"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "shortcutName": "EC AI",
      "createDesktopShortcut": true,
      "artifactName": "EC-AI-Setup-${version}.exe",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MenphinaX",
        "repo": "ElectronicCommerceAI",
        "private": false
      }
    ],
    "files": [
      "out/**/*",
      "!out/license-tool/**/*",
      "!out/task*/**/*",
      "!out/task9*.lic",
      "package.json",
      "!tools/**/*",
      "!src/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!shots/**/*",
      "!docs/**/*",
      "!**/*.log",
      "!*.md",
      "!*.lock"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "productName": "EC AI"
  },
  "author": "EC AI Team",
  "description": "EC AI 电商运营工作台"
}
